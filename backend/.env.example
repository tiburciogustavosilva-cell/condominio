# Porta do servidor da API
PORT=4000

# Chave usada para assinar os tokens JWT. Troque por um valor aleatório e secreto.
JWT_SECRET=troque_essa_chave_por_uma_bem_secreta

# ------------------------------------------------------------------
# E-mail dos lembretes de manutenção (módulo "Prestadores").
# Sem SMTP_HOST, o envio é SIMULADO: o e-mail não sai, só aparece no
# console do backend. Preencha para enviar de verdade.
# ------------------------------------------------------------------
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=usuario@seudominio.com
# SMTP_PASS=sua_senha_ou_app_password
# MAIL_FROM=Condomínio <nao-responder@seudominio.com>
