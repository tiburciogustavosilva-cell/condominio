// Espelha o estado final das antigas migrations do Supabase.
// Enums (status, papel, tipo...) ficam como String e são validados nos services.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Administradora {
  id          String       @id @default(uuid()) @db.Uuid
  nome        String
  cnpj        String       @default("")
  criadoEm    DateTime     @default(now()) @map("criado_em") @db.Timestamptz
  profiles    Profile[]
  condominios Condominio[]

  @@map("administradoras")
}

model Condominio {
  id                  String          @id @default(uuid()) @db.Uuid
  nome                String
  endereco            String          @default("")
  cnpj                String          @default("")
  temBlocos           Boolean         @default(false) @map("tem_blocos")
  qtdBlocos           Int?            @map("qtd_blocos")
  temComercio         Boolean         @default(false) @map("tem_comercio")
  qtdComercio         Int?            @map("qtd_comercio")
  temPorteiro         Boolean         @default(false) @map("tem_porteiro")
  temAreasReserva     Boolean         @default(false) @map("tem_areas_reserva")
  // Qual campo da unidade decide o peso do voto/quórum nas assembleias: "peso" (manual, padrão),
  // "fracaoIdeal" ou "pontos" — condomínios diferentes usam sistemas diferentes.
  pesoVotoPor         String          @default("peso") @map("peso_voto_por")
  // Plano contratado (basic | pro | premium) — define os módulos liberados depois do período de teste.
  plano               String          @default("basic")
  // Fim do período de teste gratuito (30 dias a partir da criação). Depois dele, só com assinatura vigente.
  trialAte            DateTime        @default(dbgenerated("(now() + '30 days'::interval)")) @map("trial_ate") @db.Timestamptz
  onboardingConcluido Boolean         @default(false) @map("onboarding_concluido")
  // Preenchido pelo admin da plataforma = acesso travado (ex.: mensalidade atrasada). null = liberado.
  bloqueadoMotivo     String?         @map("bloqueado_motivo")
  administradoraId    String?         @map("administradora_id") @db.Uuid
  administradora      Administradora? @relation(fields: [administradoraId], references: [id], onDelete: Restrict)
  criadoEm            DateTime        @default(now()) @map("criado_em") @db.Timestamptz

  profiles        Profile[]
  unidades        Unidade[]
  areas           Area[]
  chamados        Chamado[]
  comentarios     ChamadoComentario[]
  avisos          Aviso[]
  reservas        Reserva[]
  encomendas      Encomenda[]
  prestadores     Prestador[]
  manutencoes     Manutencao[]
  historicos      ManutencaoHistorico[]
  ativos          Ativo[]
  ordensServico   OrdemServico[]
  tarefas         Tarefa[]
  tarefaExecucoes TarefaExecucao[]
  tarefaFotos     TarefaFoto[]
  ocorrencias     Ocorrencia[]
  assembleias     Assembleia[]
  pautas          Pauta[]
  procuracoes     Procuracao[]
  mapaItens       MapaItem[]
  pagamentos      AssinaturaPagamento[]

  @@map("condominios")
}

// Mensalidade do condomínio com a plataforma (controle do admin): cada pagamento recebido.
// O vigente é o de maior validoAte.
model AssinaturaPagamento {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @map("condominio_id") @db.Uuid
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  valor        Decimal    @db.Decimal(12, 2)
  pagoEm       DateTime   @map("pago_em") @db.Date
  validoAte    DateTime   @map("valido_ate") @db.Date
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz

  @@index([condominioId])
  @@map("assinatura_pagamentos")
}

model Profile {
  id               String          @id @default(uuid()) @db.Uuid
  nome             String
  email            String          @unique
  senhaHash        String          @map("senha_hash")
  telefone         String?
  papel            String          @default("condomino") // sindico | condomino | administradora | funcionario | admin (dono da plataforma, sem condomínio)
  cargo            String? // só funcionário: porteiro | zelador | limpeza | ... (define o acesso)
  // Relação da pessoa com a unidade — só organizativo/informativo, não muda
  // nada de acesso (proprietário, inquilino e procurador são todos "condomino").
  vinculo          String          @default("proprietario")
  unidadeId        String?         @map("unidade_id") @db.Uuid
  unidade          Unidade?        @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  condominioId     String?         @map("condominio_id") @db.Uuid
  condominio       Condominio?     @relation(fields: [condominioId], references: [id], onDelete: Restrict)
  administradoraId String?         @map("administradora_id") @db.Uuid
  administradora   Administradora? @relation(fields: [administradoraId], references: [id], onDelete: Restrict)
  tutorialVistoEm  DateTime?       @map("tutorial_visto_em") @db.Timestamptz
  // null = cadastro público aguardando o link de confirmação (login bloqueado)
  emailConfirmadoEm DateTime?      @default(now()) @map("email_confirmado_em") @db.Timestamptz
  criadoEm         DateTime        @default(now()) @map("criado_em") @db.Timestamptz

  chamados              Chamado[]
  comentarios           ChamadoComentario[]
  avisos                Aviso[]
  reservas              Reserva[]
  ocorrencias           Ocorrencia[]
  historicoOcorrencias  OcorrenciaHistorico[]
  encomendasRegistradas Encomenda[]          @relation("EncomendasRegistradas")
  encomendasLiberadas   Encomenda[]          @relation("EncomendasLiberadas")
  tarefasConcluidas     TarefaExecucao[]
  checkins              AssembleiaPresenca[]

  @@map("profiles")
}

model Unidade {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @map("condominio_id") @db.Uuid
  condominio   Condominio @relation(fields: [condominioId], references: [id])
  numero       String
  bloco        String     @default("-")
  tipo         String     @default("apartamento")
  fracaoIdeal  Decimal    @default(0) @map("fracao_ideal") @db.Decimal(10, 4)
  // Peso do voto nas assembleias (1 = um voto normal; pode ser outro inteiro
  // ou fração pra unidade com peso diferente). Independente da fração ideal,
  // que é usada pra outras coisas (ex.: rateio).
  pesoVoto     Decimal    @default(1) @map("peso_voto") @db.Decimal(10, 4)
  // Sistema de pontos (alternativa à fração ideal que alguns condomínios usam).
  // Qual desses três decide o voto é escolhido no condomínio (`pesoVotoPor`).
  pontos       Decimal    @default(0) @map("pontos") @db.Decimal(10, 4)
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz

  profiles    Profile[]
  mapaItem    MapaItem?
  chamados    Chamado[]
  reservas    Reserva[]
  encomendas  Encomenda[]
  ocorrencias Ocorrencia[]
  presencas   AssembleiaPresenca[]
  votos       PautaVotante[]

  procuracoesConcedidas Procuracao[] @relation("ProcuracaoOutorgante")

  @@map("unidades")
}

model Area {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @map("condominio_id") @db.Uuid
  condominio   Condominio @relation(fields: [condominioId], references: [id])
  nome         String
  descricao    String     @default("")
  capacidade   Int        @default(0)
  taxa         Decimal    @default(0) @db.Decimal(12, 2)
  horario      String     @default("")
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz
  reservas     Reserva[]

  @@map("areas")
}

model Chamado {
  id           String              @id @default(uuid()) @db.Uuid
  condominioId String              @map("condominio_id") @db.Uuid
  condominio   Condominio          @relation(fields: [condominioId], references: [id])
  titulo       String
  descricao    String
  categoria    String              @default("geral")
  status       String              @default("aberto") // aberto | em_andamento | concluido
  prioridade   String              @default("media") // baixa | media | alta
  usuarioId    String              @map("usuario_id") @db.Uuid
  usuario      Profile             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidadeId    String?             @map("unidade_id") @db.Uuid
  unidade      Unidade?            @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  criadoEm     DateTime            @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime            @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz
  comentarios  ChamadoComentario[]

  @@index([usuarioId])
  @@map("chamados")
}

model ChamadoComentario {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @map("condominio_id") @db.Uuid
  condominio   Condominio @relation(fields: [condominioId], references: [id])
  chamadoId    String     @map("chamado_id") @db.Uuid
  chamado      Chamado    @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autorId      String     @map("autor_id") @db.Uuid
  autor        Profile    @relation(fields: [autorId], references: [id], onDelete: Cascade)
  texto        String
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz

  @@index([chamadoId])
  @@map("chamado_comentarios")
}

model Aviso {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @map("condominio_id") @db.Uuid
  condominio   Condominio @relation(fields: [condominioId], references: [id])
  titulo       String
  mensagem     String
  fixado       Boolean    @default(false)
  expiraEm     DateTime?  @map("expira_em") @db.Timestamptz
  autorId      String     @map("autor_id") @db.Uuid
  autor        Profile    @relation(fields: [autorId], references: [id])
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz

  @@map("avisos")
}

model Reserva {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @map("condominio_id") @db.Uuid
  condominio   Condominio @relation(fields: [condominioId], references: [id])
  areaId       String     @map("area_id") @db.Uuid
  area         Area       @relation(fields: [areaId], references: [id])
  usuarioId    String     @map("usuario_id") @db.Uuid
  usuario      Profile    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidadeId    String?    @map("unidade_id") @db.Uuid
  unidade      Unidade?   @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  data         DateTime   @db.Date
  periodo      String // manha | tarde | noite | dia_todo
  status       String     @default("pendente") // pendente | aprovada | rejeitada | cancelada
  observacao   String     @default("")
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime   @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  @@index([usuarioId])
  @@map("reservas")
}

model Encomenda {
  id                 String     @id @default(uuid()) @db.Uuid
  condominioId       String     @map("condominio_id") @db.Uuid
  condominio         Condominio @relation(fields: [condominioId], references: [id])
  unidadeId          String     @map("unidade_id") @db.Uuid
  unidade            Unidade    @relation(fields: [unidadeId], references: [id])
  observacao         String
  remetente          String     @default("")
  status             String     @default("aguardando") // aguardando | entregue
  recebidoPor        String?    @map("recebido_por") // quem retirou (informou o código)
  // Portaria: foto .webp do pacote, e o código que o morador informa na retirada
  foto               Bytes?
  codigoRetirada     String?    @map("codigo_retirada")
  codigoRastreio     String?    @map("codigo_rastreio") // da etiqueta (Correios, transportadora)
  registradoPorId    String?    @map("registrado_por_id") @db.Uuid
  registradoPor      Profile?   @relation("EncomendasRegistradas", fields: [registradoPorId], references: [id], onDelete: SetNull)
  liberadoPorId      String?    @map("liberado_por_id") @db.Uuid // funcionário que entregou
  liberadoPor        Profile?   @relation("EncomendasLiberadas", fields: [liberadoPorId], references: [id], onDelete: SetNull)
  tentativasRetirada Int        @default(0) @map("tentativas_retirada") // códigos errados; bloqueia no limite
  volumeGrande       Boolean    @default(false) @map("volume_grande")
  perecivel          Boolean    @default(false)
  criadoEm           DateTime   @default(now()) @map("criado_em") @db.Timestamptz
  entregueEm         DateTime?  @map("entregue_em") @db.Timestamptz

  // Terceiros que o morador autoriza a retirar essa encomenda além dele mesmo
  // (empregada doméstica, parente...). É só referência pra portaria — quem
  // realmente libera a retirada é o código de 5 dígitos, não o nome.
  autorizados EncomendaAutorizado[]

  @@index([unidadeId])
  @@map("encomendas")
}

model EncomendaAutorizado {
  id          String    @id @default(uuid()) @db.Uuid
  encomendaId String    @map("encomenda_id") @db.Uuid
  encomenda   Encomenda @relation(fields: [encomendaId], references: [id], onDelete: Cascade)
  nome        String
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  @@index([encomendaId])
  @@map("encomenda_autorizados")
}

model Prestador {
  id           String                @id @default(uuid()) @db.Uuid
  condominioId String                @map("condominio_id") @db.Uuid
  condominio   Condominio            @relation(fields: [condominioId], references: [id])
  nome         String
  email        String
  servico      String                @default("")
  empresa      String                @default("")
  telefone     String                @default("")
  observacao   String                @default("")
  criadoEm     DateTime              @default(now()) @map("criado_em") @db.Timestamptz
  manutencoes  ManutencaoPrestador[]

  @@map("prestadores")
}

/** Ligação N:N entre plano de manutenção e prestador — um plano pode ter mais de um responsável. */
model ManutencaoPrestador {
  id           String     @id @default(uuid()) @db.Uuid
  manutencaoId String     @map("manutencao_id") @db.Uuid
  manutencao   Manutencao @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)
  prestadorId  String     @map("prestador_id") @db.Uuid
  prestador    Prestador  @relation(fields: [prestadorId], references: [id], onDelete: Cascade)

  @@unique([manutencaoId, prestadorId])
  @@index([prestadorId])
  @@map("manutencao_prestadores")
}

model Manutencao {
  id                  String                @id @default(uuid()) @db.Uuid
  condominioId        String                @map("condominio_id") @db.Uuid
  condominio          Condominio            @relation(fields: [condominioId], references: [id])
  // Um plano de manutenção pode ter mais de um prestador (ex.: empresa + técnico).
  prestadores         ManutencaoPrestador[]
  ativoId             String?               @map("ativo_id") @db.Uuid
  equipamento         Ativo?                @relation(fields: [ativoId], references: [id], onDelete: Restrict)
  titulo              String
  descricao           String                @default("")
  ultimaManutencao    DateTime              @map("ultima_manutencao") @db.Date
  frequenciaUnidade   String                @map("frequencia_unidade") // semanal | mensal | anual
  frequenciaIntervalo Int                   @default(1) @map("frequencia_intervalo")
  diasAntecedencia    Int                   @default(0) @map("dias_antecedencia")
  ativo               Boolean               @default(true)
  ultimoLembreteCiclo DateTime?             @map("ultimo_lembrete_ciclo") @db.Date
  tipo                String                @default("preventiva")
  prioridade          String                @default("media")
  statusManual        String                @default("programada") @map("status_manual")
  custoPrevisto       Decimal?              @map("custo_previsto") @db.Decimal(12, 2)
  numeroOs            String?               @map("numero_os")
  criadoEm            DateTime              @default(now()) @map("criado_em") @db.Timestamptz
  historico           ManutencaoHistorico[]

  @@map("manutencoes")
}

model ManutencaoHistorico {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @map("condominio_id") @db.Uuid
  condominio   Condominio @relation(fields: [condominioId], references: [id])
  manutencaoId String     @map("manutencao_id") @db.Uuid
  manutencao   Manutencao @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)
  tipo         String // lembrete | realizada
  data         DateTime   @db.Date
  em           DateTime   @default(now()) @db.Timestamptz
  detalhe      String     @default("")

  @@index([manutencaoId])
  @@map("manutencao_historico")
}

model Ativo {
  id               String         @id @default(uuid()) @db.Uuid
  condominioId     String         @map("condominio_id") @db.Uuid
  condominio       Condominio     @relation(fields: [condominioId], references: [id])
  codigo           String
  nome             String
  categoria        String         @default("outros")
  localizacao      String         @default("")
  fabricanteModelo String         @default("") @map("fabricante_modelo")
  numeroSerie      String         @default("") @map("numero_serie")
  dataInstalacao   DateTime?      @map("data_instalacao") @db.Date
  vidaUtil         Int?           @map("vida_util")
  vidaUtilUnidade  String         @default("anos") @map("vida_util_unidade") // dias | semanas | meses | anos
  responsavel      String         @default("")
  observacoes      String         @default("")
  criadoEm         DateTime       @default(now()) @map("criado_em") @db.Timestamptz
  manutencoes      Manutencao[]
  ordensServico    OrdemServico[]

  @@map("ativos")
}

model OrdemServico {
  id             String     @id @default(uuid()) @db.Uuid
  condominioId   String     @map("condominio_id") @db.Uuid
  condominio     Condominio @relation(fields: [condominioId], references: [id])
  numeroOs       String?    @map("numero_os")
  dataAbertura   DateTime   @default(now()) @map("data_abertura") @db.Date
  dataExecucao   DateTime?  @map("data_execucao") @db.Date
  ativoId        String?    @map("ativo_id") @db.Uuid
  ativo          Ativo?     @relation(fields: [ativoId], references: [id], onDelete: Restrict)
  tipo           String     @default("corretiva")
  descricao      String
  diagnostico    String     @default("")
  acaoExecutada  String     @default("") @map("acao_executada")
  responsavel    String     @default("")
  prioridade     String     @default("media")
  status         String     @default("programada")
  custoMaterial  Decimal    @default(0) @map("custo_material") @db.Decimal(12, 2)
  custoMaoDeObra Decimal    @default(0) @map("custo_mao_obra") @db.Decimal(12, 2)
  observacoes    String     @default("")
  criadoEm       DateTime   @default(now()) @map("criado_em") @db.Timestamptz
  anexos         OrdemServicoAnexo[]

  @@index([ativoId])
  @@map("ordens_servico")
}

/** Nota fiscal ou orçamento anexado a uma ordem de serviço (comprovante do gasto). */
model OrdemServicoAnexo {
  id             String       @id @default(uuid()) @db.Uuid
  ordemServicoId String       @map("ordem_servico_id") @db.Uuid
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tipo           String       // nota_fiscal | orcamento
  nome           String // nome original do arquivo, só pra exibição
  mimeType       String       @map("mime_type")
  arquivo        Bytes
  criadoEm       DateTime     @default(now()) @map("criado_em") @db.Timestamptz

  @@index([ordemServicoId])
  @@map("ordem_servico_anexos")
}

model Ocorrencia {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @map("condominio_id") @db.Uuid
  condominio   Condominio @relation(fields: [condominioId], references: [id])
  titulo       String
  descricao    String
  categoria    String     @default("outro")
  status       String     @default("aberto")
  foto         Bytes?
  usuarioId    String     @map("usuario_id") @db.Uuid
  usuario      Profile    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidadeId    String?    @map("unidade_id") @db.Uuid
  unidade      Unidade?   @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime   @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  historico    OcorrenciaHistorico[]

  @@index([usuarioId])
  @@map("ocorrencias")
}

// Cada mudança de status da ocorrência, com o descritivo do que foi feito.
model OcorrenciaHistorico {
  id           String     @id @default(uuid()) @db.Uuid
  ocorrenciaId String     @map("ocorrencia_id") @db.Uuid
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  status       String
  descricao    String
  autorId      String     @map("autor_id") @db.Uuid
  autor        Profile    @relation(fields: [autorId], references: [id])
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz

  @@index([ocorrenciaId])
  @@map("ocorrencia_historico")
}

// Tarefas recorrentes dos funcionários (por cargo), concluídas com foto.
model Tarefa {
  id           String           @id @default(uuid()) @db.Uuid
  condominioId String           @map("condominio_id") @db.Uuid
  condominio   Condominio       @relation(fields: [condominioId], references: [id])
  titulo       String
  descricao    String           @default("")
  cargo        String // quem executa: qualquer funcionário desse cargo
  recorrencia  String // diaria | semanal | mensal | unica
  diasSemana   Int[]            @default([]) @map("dias_semana") // semanal: 0=dom … 6=sáb
  diaMes       Int?             @map("dia_mes") // mensal: 1–31 (31 em fevereiro = último dia)
  data         DateTime?        @db.Date // unica
  ativa        Boolean          @default(true)
  criadoEm     DateTime         @default(now()) @map("criado_em") @db.Timestamptz
  execucoes    TarefaExecucao[]

  @@map("tarefas")
}

model TarefaExecucao {
  id             String       @id @default(uuid()) @db.Uuid
  condominioId   String       @map("condominio_id") @db.Uuid
  condominio     Condominio   @relation(fields: [condominioId], references: [id])
  tarefaId       String       @map("tarefa_id") @db.Uuid
  tarefa         Tarefa       @relation(fields: [tarefaId], references: [id], onDelete: Restrict) // histórico é prova: não some junto
  data           DateTime     @db.Date // dia da ocorrência que foi cumprida
  concluidaPorId String?      @map("concluida_por_id") @db.Uuid
  concluidaPor   Profile?     @relation(fields: [concluidaPorId], references: [id], onDelete: SetNull)
  concluidaEm    DateTime     @default(now()) @map("concluida_em") @db.Timestamptz // hora do servidor
  observacao     String       @default("")
  fotos          TarefaFoto[]

  @@unique([tarefaId, data])
  @@map("tarefa_execucoes")
}

model TarefaFoto {
  id           String         @id @default(uuid()) @db.Uuid
  condominioId String         @map("condominio_id") @db.Uuid
  condominio   Condominio     @relation(fields: [condominioId], references: [id])
  execucaoId   String         @map("execucao_id") @db.Uuid
  execucao     TarefaExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  foto         Bytes

  @@index([execucaoId])
  @@map("tarefa_fotos")
}

model Assembleia {
  id           String               @id @default(uuid()) @db.Uuid
  condominioId String               @map("condominio_id") @db.Uuid
  condominio   Condominio           @relation(fields: [condominioId], references: [id])
  titulo       String
  segredo      String // gera o código de check-in rotativo; nunca sai da API
  status       String               @default("aberta") // aberta | encerrada
  criadoEm     DateTime             @default(now()) @map("criado_em") @db.Timestamptz
  encerradaEm  DateTime?            @map("encerrada_em") @db.Timestamptz
  presencas    AssembleiaPresenca[]
  pautas       Pauta[]
  procuracoes  Procuracao[]

  @@map("assembleias")
}

model AssembleiaPresenca {
  id           String     @id @default(uuid()) @db.Uuid
  assembleiaId String     @map("assembleia_id") @db.Uuid
  assembleia   Assembleia @relation(fields: [assembleiaId], references: [id], onDelete: Cascade)
  unidadeId    String     @map("unidade_id") @db.Uuid
  unidade      Unidade    @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  profileId    String?    @map("profile_id") @db.Uuid // quem fez o check-in (null = marcada pelo síndico)
  profile      Profile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  manual       Boolean    @default(false)
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz

  @@unique([assembleiaId, unidadeId])
  @@map("assembleia_presencas")
}

model Pauta {
  id                 String         @id @default(uuid()) @db.Uuid
  condominioId       String         @map("condominio_id") @db.Uuid
  condominio         Condominio     @relation(fields: [condominioId], references: [id])
  assembleiaId       String         @map("assembleia_id") @db.Uuid
  assembleia         Assembleia     @relation(fields: [assembleiaId], references: [id], onDelete: Cascade)
  titulo             String
  descricao          String         @default("")
  ordem              Int            @default(0)
  status             String         @default("rascunho") // rascunho | votando | encerrada
  // Vínculos que podem votar nessa pauta (proprietario/inquilino/procurador).
  // Por padrão todos podem; o síndico restringe ao criar/editar a pauta.
  vinculosPermitidos String[]       @default(["proprietario", "inquilino", "procurador"]) @map("vinculos_permitidos")
  opcoes             PautaOpcao[]
  votantes           PautaVotante[]

  @@index([assembleiaId])
  @@map("pautas")
}

model PautaOpcao {
  id        String  @id @default(uuid()) @db.Uuid
  pautaId   String  @map("pauta_id") @db.Uuid
  pauta     Pauta   @relation(fields: [pautaId], references: [id], onDelete: Cascade)
  texto     String
  ordem     Int     @default(0)
  votos     Int     @default(0) // total de unidades (1 unidade = 1)
  pesoVotos Decimal @default(0) @map("peso_votos") @db.Decimal(14, 4) // soma do peso_voto de quem escolheu — decide o resultado
  votantes  PautaVotante[]

  @@index([pautaId])
  @@map("pauta_opcoes")
}

/// Quem já votou (uma vez por unidade). Sem a opção nem a hora — é o que mantém o voto secreto.
model PautaVotante {
  id        String      @id @default(uuid()) @db.Uuid
  pautaId   String      @map("pauta_id") @db.Uuid
  pauta     Pauta       @relation(fields: [pautaId], references: [id], onDelete: Cascade)
  unidadeId String      @map("unidade_id") @db.Uuid
  unidade   Unidade     @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  // Voto deixou de ser secreto: qual opção essa unidade escolheu. Null só em votos
  // registrados antes dessa mudança (não dá pra reconstruir o que já era anônimo).
  opcaoId   String?     @map("opcao_id") @db.Uuid
  opcao     PautaOpcao? @relation(fields: [opcaoId], references: [id], onDelete: Restrict)

  @@unique([pautaId, unidadeId])
  @@map("pauta_votantes")
}

/// Registro da procuração (documento) de uma assembleia: qual pessoa (procurador,
/// pode ser de fora do condomínio) recebeu a procuração de qual unidade ausente
/// (outorgante). Uma linha por unidade — a mesma pessoa (CPF) pode representar
/// várias. É só registro/ata — não altera check-in nem contagem de voto.
model Procuracao {
  id                   String     @id @default(uuid()) @db.Uuid
  condominioId         String     @map("condominio_id") @db.Uuid
  condominio           Condominio @relation(fields: [condominioId], references: [id])
  assembleiaId         String     @map("assembleia_id") @db.Uuid
  assembleia           Assembleia @relation(fields: [assembleiaId], references: [id], onDelete: Cascade)
  unidadeOutorganteId  String     @map("unidade_outorgante_id") @db.Uuid // quem liberou/concedeu a procuração (ausente)
  unidadeOutorgante    Unidade    @relation("ProcuracaoOutorgante", fields: [unidadeOutorganteId], references: [id], onDelete: Restrict)
  procuradorNome       String     @map("procurador_nome") // quem tem/recebeu a procuração (representa)
  procuradorCpf        String     @map("procurador_cpf") // só dígitos
  criadoEm             DateTime   @default(now()) @map("criado_em") @db.Timestamptz

  @@unique([assembleiaId, unidadeOutorganteId]) // uma unidade só concede procuração a 1 pessoa por assembleia
  @@map("procuracoes")
}

// Mapa do condomínio (gamificado): cada peça na grade de uma camada.
// camada "geral" = terreno (casas, prédios, ruas, lazer); "bloco:<nome>" = andares do bloco.
model MapaItem {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @map("condominio_id") @db.Uuid
  condominio   Condominio @relation(fields: [condominioId], references: [id])
  camada       String
  tipo         String // unidade | bloco | rua | area_verde | playground | piscina | convivencia | quadra | estacionamento | portaria | outro
  unidadeId    String?    @unique @map("unidade_id") @db.Uuid
  unidade      Unidade?   @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  bloco        String? // tipo "bloco": qual bloco o prédio representa
  rotulo       String     @default("")
  x            Int
  y            Int
  largura      Int        @default(1)
  altura       Int        @default(1)
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz

  @@index([condominioId])
  @@map("mapa_itens")
}
